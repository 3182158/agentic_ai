OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Required to ingest PDF/DOCX (LlamaParse, https://cloud.llamaindex.ai)
LLAMA_CLOUD_API_KEY=
# LlamaCloud host (EU region: https://api.cloud.eu.llamaindex.ai)
LLAMA_CLOUD_BASE_URL=https://api.cloud.llamaindex.ai
# LlamaParse tier: fast | cost_effective | agentic | agentic_plus
# LLAMAPARSE_TIER=cost_effective


HELPDESK_DEMO_EMPLOYEE_ID=E104
# Shared with the MCP service (ticket-and-leave-manager-service). Use at least 32 random characters.
HELPDESK_MCP_SECRET=
# Optional overrides:
# HELPDESK_MCP_URL=http://127.0.0.1:9000/mcp
# HELPDESK_MAX_MODEL_STEPS=6
